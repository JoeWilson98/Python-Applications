import tkinter as tk
import random
import string

letters1 = list(string.ascii_lowercase)
letters2 = list(string.ascii_uppercase)
digits = list(string.digits)
punctuation = list(string.punctuation)

def password_generator():

        all_lists = letters1 + letters2 + digits + punctuation

        password = ""

        excluded_chars = exclude_entry.get()
        try:
            length = int(length_entry.get())
        except ValueError:
            result_label_length.config(text="Enter a valid number")
            result_label.config(text="")
            return


        for char in excluded_chars:
            if char in all_lists:
                all_lists.remove(char)

        for i in range(length):
            password += random.choice(all_lists)

        result_label.config(text=f"{password}")
        result_label_length.config(text=f"")

root = tk.Tk()
root.title("Password Generator")
root.configure(background="dark slate gray")
root.geometry("300x300+50+50")

tk.Label(root, text="Password Length:", wraplength=200).place(x = 30, y = 40)
length_entry = tk.Entry(root)
length_entry.place(x= 160, y = 40)

tk.Label(root, text="Exclude characters:").place(x = 30, y = 110)
exclude_entry = tk.Entry(root)
exclude_entry.place(x= 160, y = 110)

tk.Button(root, text="Generate Password", command=password_generator).place(x = 30, y = 190)

tk.Button(root, text="Exit", command=root.destroy).place(x =260, y = 250)


result_label = tk.Label(root, text="",bg="dark slate gray", fg="white")
result_label.place(x = 160, y = 190)

result_label_length = tk.Label(root, text="",bg="dark slate gray", fg="red")
result_label_length.place(x = 30, y = 70)
root.mainloop()
